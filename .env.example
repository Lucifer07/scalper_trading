# ==== Feed MT4 (satu-satunya sumber tick — EA bridge, lihat docs/mt4-integration.md) ====
SYMBOL=XAUUSD
# sniper = trending (D1 arah + H4/H1 konfirmasi) | handgun = ranging (M15 saja)
MODE=sniper
# jalankan beberapa strategi sekaligus (dipisah koma); order pertama yang menang
MODES=sniper,handgun

# ==== Telegram ====
# Buat bot via @BotFather -> /newbot, salin token ke sini.
# Chat ID: kirim pesan ke bot Anda, lalu buka
#   https://api.telegram.org/bot<TOKEN>/getUpdates  ->  "chat":{"id":...}
# Biarkan keduanya kosong untuk DRY-RUN (sinyal hanya tampil di console).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ==== Engine ====
# Menit anti-spam setelah satu sinyal terkirim
COOLDOWN_MINUTES=45
# Seed struktur TF besar (W1/D1/H4/...) dari Yahoo — 1=ya, 0=tidak
YAHOO_CONTEXT=0
# auto | mt4 | yahoo
# mt4 = seed H1/H4/D1/W1 dari broker (sama dengan tempat order dieksekusi)
HISTORY_SOURCE=mt4
# Tick hanya dari MT4: bar M1 native broker, poll tiap N ms.
MT4_TICK_POLL_MS=500
# Proxy Yahoo untuk XAUUSD spot (futures COMEX, basis ~beberapa dolar)
YAHOO_SYMBOL=GC=F
# Kirim pesan status tiap N menit (0 = matikan heartbeat)
HEARTBEAT_MINUTES=0
# Dead-market guard: jeda evaluasi & alert bila N bar M1 terakhir datar
# sempurna (h==l) dan harga tidak bergerak — feed MT4/demo tetap mengirim
# bar datar saat market tutup, dan evaluasi di atasnya hanya menghasilkan
# HOLD palsu. Harga bergerak 1 tick -> guard lepas otomatis. 0 = matikan.
DEAD_MARKET_GUARD=1
# Jumlah bar M1 datar berturut-turut sebelum market dianggap tutup (min 2).
DEAD_MARKET_FLAT_BARS=5

# ==== Jalur order MT4 (default OFF) — lihat docs/mt4-integration.md ====
# ORDER_ENABLED dan MT4_ALLOW_TRADING harus sama (keduanya 0 atau keduanya 1),
# dan EA juga harus di-arm (InpAllowTrading=true). Tanpa itu: monitor read-only.
ORDER_ENABLED=0
MT4_ALLOW_TRADING=0
# Port server Python yang di-dial EA (bukan port inbound).
MT4_BRIDGE_PORT=8770
# Biarkan loopback bila EA di mesin yang sama. Non-loopback WAJIB MT4_REMOTE_ALLOW=1.
MT4_BRIDGE_HOST=127.0.0.1
MT4_REMOTE_ALLOW=0
MT4_CALL_TIMEOUT=6.0
# Nama simbol persis seperti di Market Watch broker (bisa XAUUSD.m / GOLD).
MT4_SYMBOL=XAUUSD
MT4_MAGIC=20261116
# sniper = MT4_MAGIC, handgun = MT4_MAGIC+1 (posisi terpisah per mode)
MAX_POSITIONS=2
MT4_DEVIATION=30

# ==== Risiko (guard deterministik, tidak bisa ditawar AI) ====
RISK_PERCENT=0.5
MAX_LOT=0.10
MAX_SPREAD_POINTS=50
# Tolak bila harga sinyal (tick MT4) vs ask/bid broker menyimpang lebih dari ini (USD).
MAX_BASIS=3.0
# Tolak bila harga broker bergerak lebih dari ini selama review AI (USD).
MAX_DRIFT=2.0
# Pending limit (di level SL engine) dibatalkan bila tidak tersentuh selama ini.
PENDING_TTL_SECONDS=300
# Trailing TP: tutup posisi bila profit retrace >= 20% dari puncak profit.
TRAIL_RETRACE_PCT=20
# Offset limit mendekati pasar: 2% x (high-low) candle M5 terakhir, cap 10 pip.
LIMIT_OFFSET_PCT=2
LIMIT_OFFSET_MAX_PIPS=10
# Layering: beberapa limit berlapis (AI menentukan jumlah, minimal 2) dibatasi
# margin bebas + floating. Bisa di-on/off dari panel (runtime).
LAYERING_ENABLED=0
LAYERING_MIN=2
# Batas TOTAL eksposur batch (margin terpakai <= X% equity) — bukan batas jumlah layer.
LAYERING_MAX_MARGIN_PCT=2
LAYERING_MARGIN_SAFETY=0.9
# 0 = patuh .md (tanpa SL/TP di broker, exit manual). ATTACH_SL=1 = pengaman darurat.
ATTACH_SL=0
ATTACH_TP=0
ORDER_DEDUPE_SECONDS=300
ORDER_LOG=orders.jsonl

# ==== AI advisor (opsional) ====
# Mode yang direview AI. handgun TIDAK direview (latency 14-44s terlalu lama untuk M5).
ADVISOR_MODES=sniper
# Backend A — OpenCode CLI (tanpa API key; memakai auth opencode Anda):
#   model ditulis provider/model, optional #variant
ADVISOR_CLI_MODEL=
ADVISOR_BIN=/home/jayz/.opencode/bin/opencode
# Agent opencode untuk review (kosong = default). Contoh: plan
ADVISOR_AGENT=
# Backend B — endpoint OpenAI-compatible (isi ADVISOR_URL, JANGAN isi CLI_MODEL):
# .../v1 atau .../v1/chat/completions
ADVISOR_URL=
ADVISOR_MODEL=
ADVISOR_API_KEY=
# Detik. CLI butuh lebih longgar (LLM+proses): 20-30. HTTP: 5-10.
ADVISOR_TIMEOUT=60
# Band geser SL/TP oleh AI, dalam kelipatan ATR M1
ADVISOR_BAND_ATR=0.5
RULES_MD=~/ringkasan-scalping-xau-coach-tom.md
RULES_MD_MAX_CHARS=11000

# ==== Panel GUI + control API (loopback-only, tanpa auth) ====
# 1 = sediakan control API kecil di dalam monitor (dipakai panel)
CONTROL_ENABLED=1
# WAJIB loopback: control API tidak punya autentikasi. Akses panel dari mesin
# lain lewat SSH tunnel: ssh -L 8773:127.0.0.1:8773 user@host
CONTROL_HOST=127.0.0.1
# Port control API di dalam monitor (panel berjalan di :8773).
# Jangan sama dengan MT4_BRIDGE_PORT.
CONTROL_PORT=8772
# Log monitor yang di-tail panel (rotasi otomatis).
LOG_FILE=logs/monitor.log
LOG_MAX_BYTES=2000000
LOG_BACKUPS=5

# ==== Hard loss stop (opt-in) ====
# Rugi akun >= LOSS_LIMIT_USD -> batalkan pending, tutup semua posisi, lalu
# matikan unit systemd di LOSS_GUARD_STOP_UNITS. 0 = guard mati.
# Baseline saldo dibekukan di state/loss_guard.json saat guard pertama jalan;
# latch state/trading_locked.json memblokir arming setelah trigger. Untuk
# mengaktifkan lagi: hentikan app, hapus kedua file, lalu start ulang.
LOSS_LIMIT_USD=0
LOSS_GUARD_POLL_S=5
LOSS_GUARD_CONFIRM=2
# Wajib diisi saat LOSS_LIMIT_USD > 0 (nama unit systemd --user, dipisah koma).
# LOSS_GUARD_STOP_UNITS=xau-monitor.service,xau-panel.service
